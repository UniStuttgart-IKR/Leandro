# This checkout's answers to "where do the artefacts go", read by
# scripts/lib/config.sh before its defaults. Copy to local.env (git-ignored)
# and edit. The `: "${VAR:=value}"` idiom keeps the environment in charge: a
# variable exported before a script runs still wins over this file.
#
# THE ONE THAT MATTERS: LEA_VM_DIR is the artefact store -- guest instances,
# base and baked images, the upstream cloud image, measurement outputs. Put
# it on the big disk. Everything else here is optional.
: "${LEA_VM_DIR:=/mnt/vmstore/leandro/vm}"

# The image every guest overlays. The default is the plain Ubuntu cloud
# image; a baked one (build.sh bake) makes `showcase.sh up` a matter of
# seconds instead of an apt run per fresh disk.
#
# `build.sh bake --set-default` writes this line for you -- replacing the
# one below rather than adding a second, because the `: "${VAR:=value}"`
# idiom lets the FIRST assignment win and a second line would read as if it
# were in force while doing nothing.
#: "${LEA_BASE_IMAGE:=/mnt/vmstore/leandro/vm/guest-baked-<serial>-<driver>-<stamp>.qcow2}"

# cloud-hypervisor, if not the one build.sh ch puts under vendor/ -- for
# example a Nix-built one:  nix build .#cloud-hypervisor -o /mnt/vmstore/leandro/cloud-hypervisor
#: "${LEA_CH:=/mnt/vmstore/leandro/cloud-hypervisor/bin/cloud-hypervisor}"

# The host binaries, if not target/release (a Nix build, another checkout).
#: "${LEA_BIN_DIR:=/path/to/bin}"
