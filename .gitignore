tmp.md

/tmp
/vm

# Compiled probes. The SOURCES are checked in, the binaries are not.
# Prebuilt binaries used to be versioned here, and a stale one made the gate
# check output strings that no longer existed in any source -- it passed
# against text nothing produced any more. Every consumer builds them now.
/probe/bin/
# Probe run output (traces, straces, logs).
/probe/traces/
/probe/__pycache__/
/probe/**/__pycache__/

# Agent harness session state, not project material.
/.claude/
/.hurc-harness/

# This checkout's artefact locations (see local.env.example).
/local.env
/result
/jobs
/.repowise
/.vscode
/.mcp.json
/.claude

# The coverage matrix: the REPORTS are versioned, the raw measurement is not.
# matrix/traces/<driver>/ is tens of megabytes of tsv and strace output that
# `scripts/ioctl-matrix.sh trace` regenerates in minutes, and every artefact
# built from it carries the provenance of the run that produced it.
/matrix/traces/
/matrix/.tables.txt
