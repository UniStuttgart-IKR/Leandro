+    fn unmap(&mut self, req: &VhostUserMMap) -> io::Result<()> {
+        let addr = self.host_range(req)?;
+        let (shmid, offset, len) = (req.shmid, req.shm_offset, req.len);
+        if self.mappings.get(&(shmid, offset)) != Some(&len) {
+            error!("shared memory unmap {offset:#x}+{len:#x} in shmid {shmid} is not a mapping");
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        shmem_placeholder(addr, len).inspect_err(|e| {
+            error!("shared memory unmap {offset:#x}+{len:#x} in shmid {shmid} failed: {e}");
+        })?;
+        self.mappings.remove(&(shmid, offset));
+        Ok(())
+    }
+
+    /// Drop every mapping; the front-end does this across a device reset.
+    fn unmap_all(&mut self) {
+        if self.mappings.is_empty() {
+            return;
+        }
+        match shmem_placeholder(self.host_addr, self.window_len) {
+            Ok(()) => self.mappings.clear(),
+            Err(e) => error!("dropping the shared memory mappings failed: {e}"),
+        }
+    }
