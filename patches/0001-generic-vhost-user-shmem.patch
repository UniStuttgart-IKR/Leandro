+/// Entries in the `memory_sizes` array of VHOST_USER_GET_SHMEM_CONFIG.
+const MAX_SHMEM_REGIONS: usize = 256;
+
+fn page_size() -> u64 {
+    // SAFETY: sysconf has no preconditions.
+    unsafe { libc::sysconf(libc::_SC_PAGESIZE) as u64 }
+}
+
+/// Validate a VHOST_USER_GET_SHMEM_CONFIG reply and return the region sizes
+/// indexed by shmid, without trailing unused ids.
+///
+/// The array index is the shmid and `nregions` counts the non-zero entries
+/// (vhost-user specification, "VIRTIO Shared Memory Region configuration").
+/// Each size must be a multiple of the page size; a size of 0 marks an unused
+/// shmid.
+fn shmem_sizes_from_config(cfg: &VhostUserShMemConfig, page_size: u64) -> Result<Vec<u64>> {
+    let nregions = cfg.nregions as usize;
+    let sizes = cfg.memory_sizes;
+    if nregions > MAX_SHMEM_REGIONS {
+        return Err(Error::VhostUserInvalidShmemConfig(format!(
+            "{nregions} regions, at most {MAX_SHMEM_REGIONS} are possible"
+        )));
+    }
+    let used = sizes.iter().filter(|size| **size != 0).count();
+    if used != nregions {
+        return Err(Error::VhostUserInvalidShmemConfig(format!(
+            "nregions is {nregions}, but {used} region sizes are non-zero"
+        )));
+    }
+    if let Some((shmid, size)) = sizes
+        .iter()
+        .enumerate()
+        .find(|(_, size)| **size % page_size != 0)
+    {
+        return Err(Error::VhostUserInvalidShmemConfig(format!(
+            "region {shmid} size {size:#x} is not a multiple of the page size {page_size:#x}"
+        )));
+    }
+    let end = sizes
+        .iter()
+        .rposition(|size| *size != 0)
+        .map_or(0, |i| i + 1);
+    Ok(sizes[..end].to_vec())
+}
+
+/// Lay an inaccessible anonymous mapping over `len` bytes at `addr`.
+fn shmem_placeholder(addr: u64, len: u64) -> io::Result<()> {
+    // SAFETY: callers pass a range inside the shared memory window that this
+    // device owns, so MAP_FIXED replaces only mappings of that window.
+    let ret = unsafe {
+        libc::mmap(
+            addr as *mut libc::c_void,
+            len as usize,
+            libc::PROT_NONE,
+            libc::MAP_ANONYMOUS | libc::MAP_PRIVATE | libc::MAP_NORESERVE | libc::MAP_FIXED,
+            -1,
+            0,
+        )
+    };
+    if ret == libc::MAP_FAILED {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+/// The VIRTIO Shared Memory Regions of the device and the mappings the backend
+/// placed in them with VHOST_USER_BACKEND_SHMEM_MAP.
+struct ShmemState {
+    /// Host address of the window that holds all regions.
+    host_addr: u64,
+    /// Window length in bytes.
+    window_len: u64,
+    /// Regions indexed by shmid; a zero length marks an unused shmid.
+    regions: Vec<VirtioSharedMemory>,
+    /// Live mappings: (shmid, shm_offset) -> len.
+    mappings: BTreeMap<(u8, u64), u64>,
+    page_size: u64,
+}
+
+impl ShmemState {
+    fn new(host_addr: u64, window_len: u64, regions: Vec<VirtioSharedMemory>) -> Self {
+        ShmemState {
+            host_addr,
+            window_len,
+            regions,
+            mappings: BTreeMap::new(),
+            page_size: page_size(),
+        }
+    }
+
+    /// Host address of the range `req` names. The range must lie inside the
+    /// region `req.shmid` on page boundaries; offsets are relative to the
+    /// start of that region.
+    fn host_range(&self, req: &VhostUserMMap) -> io::Result<u64> {
+        let (shmid, offset, len) = (req.shmid, req.shm_offset, req.len);
+        let Some(region) = self
+            .regions
+            .get(shmid as usize)
+            .filter(|region| region.len != 0)
+        else {
+            error!("shared memory request for shmid {shmid}, which is not a region of the device");
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        };
+        if len == 0 || offset % self.page_size != 0 || len % self.page_size != 0 {
+            error!(
+                "shared memory request {offset:#x}+{len:#x} in shmid {shmid} is not page aligned"
+            );
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        if offset.checked_add(len).is_none_or(|end| end > region.len) {
+            let region_len = region.len;
+            error!(
+                "shared memory request {offset:#x}+{len:#x} exceeds shmid {shmid} of {region_len:#x} bytes"
+            );
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        Ok(self.host_addr + region.offset + offset)
+    }
+
+    /// VHOST_USER_BACKEND_SHMEM_MAP: map `fd` into a free range of a region.
+    fn map(&mut self, req: &VhostUserMMap, fd: RawFd) -> io::Result<()> {
+        let addr = self.host_range(req)?;
+        let (shmid, offset, len, fd_offset) = (req.shmid, req.shm_offset, req.len, req.fd_offset);
+        if fd_offset % self.page_size != 0 {
+            error!("shared memory map with fd offset {fd_offset:#x} is not page aligned");
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        // Mapping over an existing mapping is not allowed. Mappings do not
+        // overlap, so only the last one starting before `offset + len` can.
+        if let Some((&(_, prev_offset), &prev_len)) = self
+            .mappings
+            .range((shmid, 0)..(shmid, offset + len))
+            .next_back()
+            && prev_offset + prev_len > offset
+        {
+            error!(
+                "shared memory map {offset:#x}+{len:#x} in shmid {shmid} overlaps \
+                 {prev_offset:#x}+{prev_len:#x}"
+            );
+            return Err(io::Error::from_raw_os_error(libc::EBUSY));
+        }
+        let prot = if req.flags & VhostUserMMapFlags::WRITABLE.bits() != 0 {
+            libc::PROT_READ | libc::PROT_WRITE
+        } else {
+            libc::PROT_READ
+        };
