+        // this device owns, and the overlap check that it holds no mapping.
+        let ret = unsafe {
+            libc::mmap(
+                addr as *mut libc::c_void,
+                len as usize,
+                prot,
+                libc::MAP_SHARED | libc::MAP_FIXED,
+                fd,
+                fd_offset as libc::off_t,
+            )
+        };
+        if ret == libc::MAP_FAILED {
