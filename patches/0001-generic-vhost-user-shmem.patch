+#[cfg(test)]
+mod tests {
+    use std::fs::File;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::fs::FileExt;
+    use std::os::unix::net::UnixStream;
+    use std::{ptr, thread};
+
+    use vhost_frontend::vhost_user::Backend;
+    use vmm_sys_util::eventfd::EventFd;
+
+    use super::*;
+
+    fn einval(r: io::Result<()>) -> bool {
+        r.is_err_and(|e| e.raw_os_error() == Some(libc::EINVAL))
+    }
+
+    #[test]
+    fn shmem_config_is_indexed_by_shmid() {
+        let p = page_size();
+        let cfg = |n, sizes: &[u64]| VhostUserShMemConfig::new(n, sizes);
+        assert_eq!(
+            shmem_sizes_from_config(&cfg(1, &[0, 4 * p]), p).unwrap(),
+            [0, 4 * p]
+        );
+        assert_eq!(
+            shmem_sizes_from_config(&cfg(2, &[p, 0, 2 * p, 0]), p).unwrap(),
+            [p, 0, 2 * p]
+        );
+        assert!(shmem_sizes_from_config(&cfg(0, &[]), p).unwrap().is_empty());
+    }
+
+    #[test]
+    fn shmem_config_is_validated() {
+        let p = page_size();
+        let cfg = |n, sizes: &[u64]| VhostUserShMemConfig::new(n, sizes);
+        // nregions counts the non-zero sizes; it is not a prefix length.
+        shmem_sizes_from_config(&cfg(2, &[0, 4 * p]), p).unwrap_err();
+        shmem_sizes_from_config(&cfg(1, &[p, p]), p).unwrap_err();
+        shmem_sizes_from_config(&cfg(1, &[p + 1]), p).unwrap_err();
+        shmem_sizes_from_config(&cfg(257, &[]), p).unwrap_err();
+    }
+
+    /// Eight pages; shmid 0 unused, shmid 1 is four pages at window offset
+    /// one page, so region and window offsets differ.
+    struct Window {
+        addr: u64,
+        len: u64,
+    }
+
+    impl Window {
+        fn new() -> (Self, ShmemState) {
+            let p = page_size();
+            let len = 8 * p;
+            // SAFETY: a fresh anonymous mapping, owned by the Window.
+            let addr = unsafe {
+                libc::mmap(
+                    ptr::null_mut(),
+                    len as usize,
+                    libc::PROT_NONE,
+                    libc::MAP_ANONYMOUS | libc::MAP_PRIVATE | libc::MAP_NORESERVE,
+                    -1,
+                    0,
+                )
+            };
+            assert_ne!(addr, libc::MAP_FAILED);
+            let addr = addr as u64;
+            let regions = vec![
+                VirtioSharedMemory { offset: 0, len: 0 },
+                VirtioSharedMemory {
+                    offset: p,
+                    len: 4 * p,
+                },
+            ];
+            (Window { addr, len }, ShmemState::new(addr, len, regions))
+        }
+    }
+
+    impl Drop for Window {
+        fn drop(&mut self) {
+            // SAFETY: unmaps the mapping created in Window::new.
+            unsafe { libc::munmap(self.addr as *mut libc::c_void, self.len as usize) };
+        }
+    }
+
+    fn memfd(len: u64) -> File {
+        // SAFETY: plain syscall; the fd is owned by the File.
+        let fd = unsafe { libc::memfd_create(c"shmem-test".as_ptr(), 0) };
+        assert!(fd >= 0);
+        // SAFETY: fd is a fresh descriptor nobody else owns.
+        let file = unsafe { File::from_raw_fd(fd) };
+        file.set_len(len).unwrap();
+        file
+    }
+
+    fn req(shmid: u8, shm_offset: u64, len: u64) -> VhostUserMMap {
+        VhostUserMMap {
+            shmid,
+            shm_offset,
+            len,
+            flags: VhostUserMMapFlags::WRITABLE.bits(),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn map_offsets_are_relative_to_the_region() {
+        let p = page_size();
+        let (w, mut state) = Window::new();
+        let file = memfd(p);
+        file.write_all_at(b"shmid1", 0).unwrap();
+        state.map(&req(1, p, p), file.as_raw_fd()).unwrap();
+        // Region 1 starts one page into the window; offset p is page 2.
+        let at = (w.addr + 2 * p) as *const [u8; 6];
+        // SAFETY: the page was just mapped readable.
+        assert_eq!(unsafe { ptr::read_volatile(at) }, *b"shmid1");
+    }
+
+    #[test]
+    fn map_refuses_what_the_specification_does_not_allow() {
+        let p = page_size();
+        let (_w, mut state) = Window::new();
+        let fd = memfd(4 * p);
+        let fd = fd.as_raw_fd();
+        assert!(einval(state.map(&req(0, 0, p), fd)), "unused shmid");
+        assert!(einval(state.map(&req(2, 0, p), fd)), "unknown shmid");
+        assert!(
+            einval(state.map(&req(1, 3 * p, 2 * p), fd)),
+            "past the region"
+        );
+        assert!(einval(state.map(&req(1, 1, p), fd)), "unaligned offset");
+        assert!(einval(state.map(&req(1, 0, p + 1), fd)), "unaligned length");
+        let mut unaligned_fd_offset = req(1, 0, p);
+        unaligned_fd_offset.fd_offset = 1;
+        assert!(einval(state.map(&unaligned_fd_offset, fd)));
+
+        state.map(&req(1, 0, 2 * p), fd).unwrap();
+        let overlap = state.map(&req(1, p, 2 * p), fd);
+        assert_eq!(overlap.unwrap_err().raw_os_error(), Some(libc::EBUSY));
+        state.map(&req(1, 2 * p, p), fd).unwrap();
+        assert_eq!(state.mappings.len(), 2);
+    }
+
+    #[test]
+    fn unmap_needs_exactly_one_mapping() {
+        let p = page_size();
+        let (_w, mut state) = Window::new();
+        let fd = memfd(4 * p);
+        state.map(&req(1, 0, 2 * p), fd.as_raw_fd()).unwrap();
+        assert!(einval(state.unmap(&req(1, 0, p))), "part of a mapping");
+        assert!(einval(state.unmap(&req(1, 2 * p, p))), "no mapping");
+        state.unmap(&req(1, 0, 2 * p)).unwrap();
+        assert!(einval(state.unmap(&req(1, 0, 2 * p))), "already unmapped");
+        state.map(&req(1, 0, p), fd.as_raw_fd()).unwrap();
+    }
+
+    #[test]
+    fn reset_drops_every_mapping() {
+        let p = page_size();
+        let (_w, mut state) = Window::new();
+        let fd = memfd(4 * p);
+        state.map(&req(1, 0, p), fd.as_raw_fd()).unwrap();
+        state.map(&req(1, 2 * p, p), fd.as_raw_fd()).unwrap();
+        state.unmap_all();
+        assert!(state.mappings.is_empty());
+        state.map(&req(1, 0, 4 * p), fd.as_raw_fd()).unwrap();
+    }
+
+    struct NoInterrupt;
+
+    impl VirtioInterrupt for NoInterrupt {
+        fn trigger(&self, _int_type: VirtioInterruptType) -> io::Result<()> {
+            Ok(())
+        }
+
+        fn set_notifier(
+            &self,
+            _int_type: u32,
+            _notifier: Option<EventFd>,
+            _vm: &dyn hypervisor::Vm,
+        ) -> io::Result<()> {
+            unimplemented!()
+        }
+    }
+
+    /// A backend and this handler over a backend channel with REPLY_ACK.
+    fn channel(
+        state: ShmemState,
+        backend_send_fd: bool,
+    ) -> (FrontendReqHandler<BackendReqHandler>, Backend) {
+        let mut frontend = FrontendReqHandler::new(Arc::new(BackendReqHandler {
+            interrupt_cb: Arc::new(NoInterrupt),
+            shmem: Some(Arc::new(Mutex::new(state))),
+            backend_send_fd,
+        }))
+        .unwrap();
+        frontend.set_reply_ack_flag(true);
+        // SAFETY: dup returns a new descriptor owned by the stream.
+        let sock = unsafe { UnixStream::from_raw_fd(libc::dup(frontend.get_tx_raw_fd())) };
+        let backend = Backend::from_stream(sock);
+        backend.set_reply_ack_flag(true);
+        backend.set_shmem_flag(true);
+        (frontend, backend)
+    }
+
+    #[test]
+    fn backend_requests_get_a_zero_or_non_zero_reply() {
+        let p = page_size();
+        let (_w, state) = Window::new();
+        let (mut frontend, backend) = channel(state, true);
+        let file = memfd(p);
+        let replies = thread::spawn(move || {
+            [
+                backend.shmem_map(&req(1, 0, p), &file).is_ok(),
+                backend.shmem_map(&req(1, 0, p), &file).is_ok(),
+                backend.shmem_unmap(&req(1, 0, 2 * p)).is_ok(),
+                backend.shmem_unmap(&req(1, 0, p)).is_ok(),
+            ]
+        });
+        let handled: Vec<bool> = (0..4).map(|_| frontend.handle_request().is_ok()).collect();
+        let replies = replies.join().unwrap();
+        assert_eq!(replies, [true, false, false, true]);
+        assert_eq!(handled, replies);
+    }
+
+    #[test]
+    fn map_needs_backend_send_fd() {
+        let p = page_size();
+        let (_w, state) = Window::new();
+        let (mut frontend, backend) = channel(state, false);
+        let file = memfd(p);
+        let reply = thread::spawn(move || backend.shmem_map(&req(1, 0, p), &file).is_ok());
+        frontend.handle_request().unwrap_err();
+        assert!(!reply.join().unwrap());
+    }
+}
