+/// The host-side window a backend may map into, as raw address and length.
+/// Only set when SHARED MEMORY was negotiated and the VMM allocated a window.
+#[derive(Copy, Clone)]
+struct ShmemWindow {
+    addr: u64,
+    len: u64,
+}
+
 struct BackendReqHandler {
     interrupt_cb: Arc<dyn VirtioInterrupt>,
+    shmem: Option<ShmemWindow>,
+}
+
+impl BackendReqHandler {
+    /// Bounds-check a backend request against the window. The backend is not
+    /// trusted: it may ask for an offset or length outside the window, which
+    /// would make us mmap over unrelated VMM memory.
+    fn window_target(&self, req: &VhostUserMMap) -> io::Result<u64> {
+        let w = self
+            .shmem
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?;
+        let (offset, len) = (req.shm_offset, req.len);
+        let end = offset
+            .checked_add(len)
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?;
+        if len == 0 || end > w.len {
+            let wlen = w.len;
+            error!("shmem request {offset:#x}+{len:#x} outside window of {wlen:#x}");
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        Ok(w.addr + offset)
+    }
 }
 
