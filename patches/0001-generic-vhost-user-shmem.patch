+    /// Map a backend-provided fd into the device's shared memory window, so
+    /// the guest can reach host memory through the device's PCI BAR.
+    fn shmem_map(&self, req: &VhostUserMMap, fd: &dyn AsRawFd) -> io::Result<u64> {
+        let target = self.window_target(req)?;
+        let prot = if req.flags & VhostUserMMapFlags::WRITABLE.bits() != 0 {
+            libc::PROT_READ | libc::PROT_WRITE
+        } else {
+            libc::PROT_READ
+        };
+        // SAFETY: `target`..`target + len` lies inside the window we allocated
+        // and still own (checked above), so MAP_FIXED replaces only our own
+        // PROT_NONE placeholder.
+        let addr = unsafe {
+            libc::mmap(
+                target as *mut libc::c_void,
+                req.len as usize,
+                prot,
+                libc::MAP_SHARED | libc::MAP_FIXED,
+                fd.as_raw_fd(),
+                req.fd_offset as libc::off_t,
+            )
+        };
+        if addr == libc::MAP_FAILED {
+            let e = io::Error::last_os_error();
+            let len = req.len;
+            error!("shmem_map at {target:#x} len {len:#x} failed: {e}");
+            return Err(e);
+        }
+        Ok(0)
+    }
+
+    /// Undo a mapping by laying an anonymous PROT_NONE region back over it.
+    /// Plain munmap would punch a hole in the window that a later map could
+    /// not fill with MAP_FIXED reliably.
+    fn shmem_unmap(&self, req: &VhostUserMMap) -> io::Result<u64> {
+        let target = self.window_target(req)?;
+        // SAFETY: same as above -- the range is inside our own window.
+        let addr = unsafe {
+            libc::mmap(
+                target as *mut libc::c_void,
+                req.len as usize,
+                libc::PROT_NONE,
+                libc::MAP_ANONYMOUS | libc::MAP_PRIVATE | libc::MAP_FIXED,
+                -1,
+                0,
+            )
+        };
+        if addr == libc::MAP_FAILED {
+            let e = io::Error::last_os_error();
+            let len = req.len;
+            error!("shmem_unmap at {target:#x} len {len:#x} failed: {e}");
+            return Err(e);
+        }
+        Ok(0)
+    }
 }
 
