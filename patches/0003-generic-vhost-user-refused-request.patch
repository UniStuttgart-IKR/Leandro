From 993681a04d0c055dfe64d26e58913aaf2c7fafa1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Silas=20M=C3=BCller?= <dev@silasmueller.de>
Date: Wed, 23 Sep 2026 15:18:59 +0200
Subject: [PATCH 3/3] vhost_user: keep serving the backend channel after a
 refused request

The vhost-user epoll worker treats every error from
FrontendReqHandler::handle_request() as fatal: it marks the device
disconnected and ends the worker, so no later backend request is served.

The vhost-user specification lets backend requests fail. For
VHOST_USER_BACKEND_SHMEM_MAP it requires the frontend to refuse a
mapping over an existing mapping and allows a refusal when resources run
out; with VHOST_USER_PROTOCOL_F_REPLY_ACK negotiated and NEED_REPLY set,
the frontend replies non-zero. A refusal is a normal outcome of the
request, not a broken channel.

handle_request() returns Error::ReqHandlerError exactly when the handler
refused the request, and it sends the reply, when one was asked for,
before returning. The channel is therefore still in step and the worker
continues after logging the refusal. Every other error means the socket
is broken or the stream is out of step, and still ends the worker.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 virtio-devices/src/vhost_user/mod.rs | 48 +++++++++++++++++++++++-----
 1 file changed, 40 insertions(+), 8 deletions(-)

diff --git a/virtio-devices/src/vhost_user/mod.rs b/virtio-devices/src/vhost_user/mod.rs
index a007143fc..6b1273470 100644
--- a/virtio-devices/src/vhost_user/mod.rs
+++ b/virtio-devices/src/vhost_user/mod.rs
@@ -409,14 +409,7 @@ impl<S: VhostUserFrontendReqHandler> EpollHelperHandler for VhostUserEpollHandle
             }
             BACKEND_REQ_EVENT => {
                 if let Some(backend_req_handler) = self.backend_req_handler.as_mut() {
-                    backend_req_handler
-                        .handle_request()
-                        .map(|_| ())
-                        .map_err(|e| {
-                            EpollHelperError::HandleEvent(anyhow!(
-                                "Failed to handle request from vhost-user backend: {e:?}"
-                            ))
-                        })
+                    backend_request_outcome(backend_req_handler.handle_request(), &self.socket_path)
                 } else {
                     Ok(())
                 }
@@ -434,6 +427,30 @@ impl<S: VhostUserFrontendReqHandler> EpollHelperHandler for VhostUserEpollHandle
     }
 }
 
+/// Decide whether the worker survives a backend request.
+///
+/// `ReqHandlerError` is a request the handler refused. The vhost-user
+/// specification lets such a request fail with a non-zero reply, and
+/// `FrontendReqHandler::handle_request` has already sent that reply if the
+/// backend asked for one (REPLY_ACK and NEED_REPLY) before returning the
+/// error, so the channel is still in step. Every other error means the
+/// channel is broken or out of step, and ends the worker.
+fn backend_request_outcome(
+    result: result::Result<u64, VhostUserError>,
+    socket_path: &str,
+) -> result::Result<(), EpollHelperError> {
+    match result {
+        Ok(_) => Ok(()),
+        Err(VhostUserError::ReqHandlerError(e)) => {
+            warn!("vhost-user backend request refused for socket {socket_path}: {e}");
+            Ok(())
+        }
+        Err(e) => Err(EpollHelperError::HandleEvent(anyhow!(
+            "Failed to handle request from vhost-user backend: {e:?}"
+        ))),
+    }
+}
+
 /// Common snapshot state for all vhost-user device types.
 ///
 /// Generic over `C` which is the device-specific config type
@@ -876,3 +893,18 @@ impl VhostUserCommon {
         Ok(())
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_a_refused_backend_request_keeps_the_worker() {
+        backend_request_outcome(Ok(0), "socket").unwrap();
+        let refused = VhostUserError::ReqHandlerError(io::Error::from_raw_os_error(libc::EINVAL));
+        backend_request_outcome(Err(refused), "socket").unwrap();
+        backend_request_outcome(Err(VhostUserError::InvalidMessage), "socket").unwrap_err();
+        let broken = VhostUserError::SocketBroken(io::Error::from_raw_os_error(libc::EPIPE));
+        backend_request_outcome(Err(broken), "socket").unwrap_err();
+    }
+}
